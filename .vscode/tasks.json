{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "VICTORY Release",
			"type": "shell",
			"command": "cargo",
			"args": [
				"build",
				"--release",
				"-p",
				"victory"
			],
			"problemMatcher": [
				"$rustc"
			],
			"group": "build"
		},
		{
			"label": "VICTORY Prepare shaders and run",
			"type": "shell",
			"command": "powershell",
			"args": ["-NoProfile", "-File", "${workspaceFolder}/tools/Start-Victory.ps1"],
			"dependsOn": "VICTORY Release",
			"problemMatcher": []
		}
	]
}
